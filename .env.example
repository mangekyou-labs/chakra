# Chakra — Arc testnet (never commit real .env)
# Public RPC only. Do not use Canteen $RPC (no eth_subscribe).
# Failovers: Blockdaemon HTTP; dRPC HTTP/WS; QuickNode HTTP/WS. No Alchemy URL.

CHAKRA_CHAIN_ID=5042002
CHAKRA_RPC_HTTP=https://rpc.testnet.arc.io
CHAKRA_RPC_WS=wss://rpc.testnet.arc.io
CHAKRA_RPC_HTTP_FAILOVERS=https://rpc.blockdaemon.testnet.arc.io,https://rpc.drpc.testnet.arc.io,https://rpc.quicknode.testnet.arc.io
CHAKRA_RPC_WS_FAILOVERS=wss://rpc.drpc.testnet.arc.io,wss://rpc.quicknode.testnet.arc.io

# Redis
CHAKRA_REDIS_URL=redis://127.0.0.1:6379
# Keys use prefix chakra: (see market-snapshot::REDIS_PREFIX)

# Catalog — canonical curated (2026-08-29): USDC / EURC / cirBTC.
# cirBTC is a fixed canonical Arc token; no Chakra-owned mBTC in the public path.
CHAKRA_CIRBTC_ADDRESS=0xf0C4a4CE82A5746AbAAd9425360Ab04fbBA432BF

# Arc predeploys / frozen catalog. Permit2 defaults in DeployAggregator.s.sol:
CHAKRA_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
CHAKRA_USDC_ADDRESS=0x3600000000000000000000000000000000000000
CHAKRA_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# Venue manifest (canonical curated, 2026-08-29):
#   XyloNet factory/router, Presto hub, UnitFlow V2.5 factory.
CHAKRA_XYLO_FACTORY=0x60EDeFB094B84BBC6430cc130B358A43Ba1979e2
CHAKRA_XYLO_ROUTER=0x73742278c31a76dBb0D2587d03ef92E6E2141023
CHAKRA_PRESTO_HUB=0x5794a8284A29493871Fbfa3c4f343D42001424D6
CHAKRA_UNITFLOW_FACTORY=0xd67F63A4F26a497b364d1C82e6747Aec8B5743a5
# Fixture-only (chain-31337): never deployed by the Arc operator workflow.
CHAKRA_XYK_FACTORY=0x0c812E5D55D767533c8E4783D33b28EA825b4D8e
CHAKRA_STABLE_FACTORY=0x77Ce21FDAAea40Fd94aCf65fF3220A0A7Db7D690
CHAKRA_CLMM_FACTORY=0xf6dEa9e6dfE392aaBE366240db4839709572fa69

# Worker — factory tuples are address:dex_type (xyk|stable|clmm|xylo|presto).
# Source ids: xylo → xylo-stable, presto → presto-hub, unitflow → unitflow-v25.
CHAKRA_SEED_FACTORIES=0x60EDeFB094B84BBC6430cc130B358A43Ba1979e2:xylo,0x5794a8284A29493871Fbfa3c4f343D42001424D6:presto,0xd67F63A4F26a497b364d1C82e6747Aec8B5743a5:xyk
CHAKRA_DISCOVERY_FACTORIES=
CHAKRA_EVM_WS_ENABLED=true
CHAKRA_EVM_POLL_INTERVAL_MS=500
CHAKRA_EVM_MAX_CATCHUP_BLOCKS=64
CHAKRA_DISCOVERY_INTERVAL_SECS=600

# API
CHAKRA_CORS_ORIGINS=http://localhost:3000
CHAKRA_LISTEN_ADDR=127.0.0.1:8080
# Aggregator address for /build_tx `to` (empty until T5.2 broadcast).
CHAKRA_AGGREGATOR=0xEa1b2C24bd41163590960F8e40afe6cb4CC92006

# UI (direct to API — no Next rewrite)
NEXT_PUBLIC_CHAKRA_API_URL=http://127.0.0.1:8080
