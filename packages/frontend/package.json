    "@testing-library/user-event": "^14.6.6",
    "@types/node": "20.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "es-object-atoms": "^1.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
