{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/docs/api", "destination": "/docs/api.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
